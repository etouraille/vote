# Node 3 of 3 — joins the cluster through node 1 (any already-alive member
# would work equally well as a seed; node 1 is just a convenient constant).

PORT=8093
QUEEL_INTERNAL_PORT=9193
QUEEL_DATA_DIR=./node3
QUEEL_RBAC_PATH=./rbac.db

QUEEL_NODE_ADDRESS=http://localhost:9193
QUEEL_SEED_NODE=http://localhost:9191
QUEEL_REPLICATION_FACTOR=3
QUEEL_GOSSIP_INTERVAL=2s
