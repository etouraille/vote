# Node 1 of 3 — the seed: founds the cluster, so QUEEL_SEED_NODE stays unset.
# Only node-specific overrides live here; DATABASE_URL/JWT_SECRET/etc come
# from api/.env — see api/cluster/README.md (or just `make up`, from this
# directory). All paths below are relative to api/cluster/, which is where
# both the Makefile and a manual launch (`cd api/cluster`) run from.
#
# QUEEL_ROOT_UUID here bootstraps this cluster's own (empty) rbac.json with
# a root user under the same UUID your main api/.env's account already uses
# — set QUEEL_ROOT_UUID below to whatever value backoffice-root's account is
# linked to in Postgres (rbac_uuid column) so the same login works against
# both the single-node dev api and this cluster. It's a one-time bootstrap,
# safe to leave set across restarts (a no-op once that UUID already exists
# in rbac.db).
PORT=8091
QUEEL_INTERNAL_PORT=9191
QUEEL_DATA_DIR=./node1
QUEEL_RBAC_PATH=./rbac.db
QUEEL_ROOT_UUID=d4617b07-d7f6-4b27-9d90-7b32321982c0

QUEEL_NODE_ADDRESS=http://localhost:9191
QUEEL_REPLICATION_FACTOR=3
QUEEL_GOSSIP_INTERVAL=2s
QUEEL_ANTI_ENTROPY_INTERVAL=5s
