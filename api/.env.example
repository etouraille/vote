DATABASE_URL=postgres://vote:vote@localhost:5432/vote?sslmode=disable
PORT=8080
FRONT_BASE_URL=http://localhost:4300
QUEEL_DATA_DIR=./data

# Signs every session token (see queel/rbac's JWT helpers) — required, no
# default. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Where the rbac permission directory's SQLite database lives; defaults to
# QUEEL_DATA_DIR/rbac.db if unset. SQLite (not a hand-rolled flat file)
# specifically so several api processes sharing this same path — several
# cluster nodes on one machine, say — can safely read and write it
# concurrently; see queel/rbac's package doc. Ignored once QUEEL_NODE_ADDRESS
# (below) puts this process in cluster mode: rbac then rides the same
# replicated Store as everything else instead, since a local SQLite file
# can't safely be shared once nodes aren't on the same machine.
QUEEL_RBAC_PATH=

# One-time bootstrap: on first start, creates a root rbac user under this
# exact UUID (a no-op on later restarts). Use it to get one root identity
# that can then grant every other user's rights via
# PUT /api/admin/users/{id}/permissions. Leave unset once you no longer
# need it.
QUEEL_ROOT_UUID=

# RAG search over finalized texts — both self-hosted, see docker-compose.yml
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION=texts
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# CloseRound forks a new Text per closed round (see queel.Text.PreviousTextID)
# rather than mutating one in place, so by default every finalized version
# stays independently searchable. Set to "true" to instead remove a text's
# previous version from the search index as soon as its successor is
# indexed, so search only ever surfaces the latest version of each text.
SEARCH_PRUNE_SUPERSEDED=false

# How often the background worker checks for rounds scheduled to close "in
# N days" (see POST /api/texts/{id}/schedule-close) whose due date has
# arrived. Default 1h — scheduling only ever happens in whole-day
# increments, so this doesn't need to run more often than that.
SCHEDULED_CLOSE_CHECK_INTERVAL=1h

# Brevo transactional email API (Transactional > SMTP & API in the Brevo dashboard)
BREVO_API_KEY=
MAIL_FROM=

# "Sign in with Google" (POST /api/auth/google) — left unset, the route
# isn't mounted at all and the login page's Google button has nothing to
# talk to. From Google Cloud Console: APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Application type "Web
# application". Add this app's origin(s) (e.g. http://localhost:4200, and
# your real front end domain later) under "Authorized JavaScript origins" —
# no redirect URI is needed, this only ever verifies an ID token, never
# does a server-side code exchange. Copy the "Client ID" (NOT the client
# secret — that's for the code-exchange flow this doesn't use) here, and
# the exact same value into front/src/app/google-client-id.ts: the front
# end uses it to initialize Google's sign-in button, and this api verifies
# every incoming ID token's `aud` claim against it (see
# queel/rbac.VerifyGoogleIDToken) — a mismatch between the two rejects
# every Google sign-in attempt.
GOOGLE_CLIENT_ID=

# Audience expected on ID tokens coming from the Flutter app: checked
# instead of GOOGLE_CLIENT_ID above whenever a request carries the header
# `X-Queel-Client: mobile` (see mobile's ApiClient, and googleAudience in
# auth.go). The Angular front sends no such header and stays on
# GOOGLE_CLIENT_ID.
#
# Copy the value the app itself is built with — mobile/lib/config/.env's
# GOOGLE_SERVER_CLIENT_ID, which is what google_sign_in passes as
# `serverClientId` and hence what Google stamps into the token's `aud`.
# That is a *Web* OAuth client, so today it holds the same value as
# GOOGLE_CLIENT_ID; the split exists so mobile can be moved onto its own
# web client later without touching the front end. Never the Android OAuth
# client — that one authorizes the app by package name and signing
# certificate, and is never named in code or config. Putting it here (or in
# the app's serverClientId) fails with "[28444] Developer console is not
# set up correctly".
#
# Optional and independent of GOOGLE_CLIENT_ID: left empty, the web front
# keeps working and only mobile sign-ins are refused, with an explicit
# "non configurée" error rather than a misleading invalid-token 401.
GOOGLE_CLIENT_ID_MOBILE=

# Push notifications (see notify/push_channel.go). Path to a Google
# service-account JSON key with the Firebase Cloud Messaging API enabled:
# Firebase console > Project settings > Service accounts > Generate new
# private key. The project_id inside the file is the FCM project messages
# are sent to — nothing else needs configuring here.
#
# Use an absolute path. This file is read by processes that don't share a
# working directory — the api starts from api/, the cluster nodes from
# api/queel/deploy/ — so a relative path resolves for one and not the other,
# silently disabling push on whichever misses it (the failure is a log line
# at startup, not an error).
#
# This is a private key: keep the file outside the repository, readable
# only by the api process. Unlike GOOGLE_CLIENT_ID above, it is not public.
#
# Optional, and independent of the other channels. Left empty, push is
# disabled and the remaining channels still deliver; a file that exists but
# can't be parsed disables push with a log line rather than stopping
# startup. The mobile app's own Firebase settings live in
# mobile/lib/config/.env, which also documents the Android setup end to end.
FCM_SERVICE_ACCOUNT_FILE=

# Notification channels are additive and all optional:
#   - log   always on, records who would have been notified
#   - push  requires FCM_SERVICE_ACCOUNT_FILE above
#   - email requires BREVO_API_KEY and MAIL_FROM further up
# The enabled set is logged at startup ("notify: channels enabled: [...]").
# Nothing needs to be listed here: a channel is on precisely when what it
# needs is configured.

# Cluster mode (see queel/bootstrap) — all optional. Leave QUEEL_NODE_ADDRESS
# unset to run single-node, exactly as if this whole section didn't exist.
#
# QUEEL_NODE_ADDRESS: this node's own reachable address for peer traffic,
#   e.g. http://10.0.0.2:9090 — required to opt into cluster mode.
# QUEEL_SEED_NODE: address of one existing cluster member to join through.
#   Leave unset on the very first node of a new cluster.
# QUEEL_INTERNAL_PORT: port the internal replication endpoints (raw,
#   unauthenticated put/get/scan/gossip — see queel/server.NewInternalHandler)
#   listen on, deliberately separate from PORT so they're never reachable
#   from wherever the public API is exposed. Default 9090.
# QUEEL_REPLICATION_FACTOR: how many nodes each key is replicated to.
#   Default 3.
# QUEEL_GOSSIP_INTERVAL: how often membership gossips with a random peer.
#   Default 2s.
# QUEEL_ANTI_ENTROPY_INTERVAL: how often this node compares its entire
#   keyspace against a random peer's (via a Merkle tree, see queel/merkle
#   and queel/cluster.RunAntiEntropy) and repairs whatever differs — catches
#   data a peer missed (a partition, a disk loss) that nobody happens to
#   read again, which read-repair alone never would. Default 5m.
QUEEL_NODE_ADDRESS=
QUEEL_SEED_NODE=
QUEEL_INTERNAL_PORT=9090
QUEEL_REPLICATION_FACTOR=3
QUEEL_GOSSIP_INTERVAL=2s
QUEEL_ANTI_ENTROPY_INTERVAL=5m

#private key firabase to send messages
FCM_SERVICE_ACCOUNT_FILE=