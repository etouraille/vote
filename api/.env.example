DATABASE_URL=postgres://vote:vote@localhost:5432/vote?sslmode=disable
PORT=8080
FRONT_BASE_URL=http://localhost:4300
QUEEL_DATA_DIR=./data

# Signs every session token (see queel/rbac's JWT helpers) — required, no
# default. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Where the rbac permission directory's flat file lives; defaults to
# QUEEL_DATA_DIR/rbac.json if unset.
QUEEL_RBAC_PATH=

# One-time bootstrap: on first start, creates a root rbac user under this
# exact UUID (a no-op on later restarts). Use it to get one root identity
# that can then grant every other user's rights via
# PUT /api/admin/users/{id}/permissions. Leave unset once you no longer
# need it.
QUEEL_ROOT_UUID=

# RAG search over finalized texts — both self-hosted, see docker-compose.yml
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION=texts
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# CloseRound forks a new Text per closed round (see queel.Text.PreviousTextID)
# rather than mutating one in place, so by default every finalized version
# stays independently searchable. Set to "true" to instead remove a text's
# previous version from the search index as soon as its successor is
# indexed, so search only ever surfaces the latest version of each text.
SEARCH_PRUNE_SUPERSEDED=false

# Brevo transactional email API (Transactional > SMTP & API in the Brevo dashboard)
BREVO_API_KEY=
MAIL_FROM=
